# Copy this file to .env (which git ignores) and fill in only what you use. Never commit .env.
# Connectors are optional: the kit makes films for free without any of these.

# Spending caps in US dollars for paid generation. Nothing is spent unless both are above zero.
# The first is per film; the second covers every film in this folder together.
FILM_GEN_BUDGET_USD=0
FILM_GEN_BUDGET_TOTAL_USD=0

# Provider keys (leave blank the ones you do not use)
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
